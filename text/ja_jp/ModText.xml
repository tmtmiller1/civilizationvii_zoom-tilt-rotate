        <Replace Tag="LOC_ZOOM_TILT_ROTATE_KEY_NAME_WIN" Language="ja_JP"><Text>Win</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_KEY_NAME_SPACE" Language="ja_JP"><Text>スペース</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_KEY_NAME_ESC" Language="ja_JP"><Text>Esc</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_KEY_NAME_BACKSPACE" Language="ja_JP"><Text>Backspace</Text></Replace>
