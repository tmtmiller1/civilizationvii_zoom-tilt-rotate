<?xml version="1.0" encoding="utf-8"?>
<Database>
    <LocalizedText>
        <Replace Tag="LOC_MOD_ZOOM_TILT_ROTATE_NAME" Language="zh_Hant_HK"><Text>縮放、俯仰與旋轉</Text></Replace>
        <Replace Tag="LOC_MOD_ZOOM_TILT_ROTATE_DESCRIPTION" Language="zh_Hant_HK"><Text>放大和縮小都能超出遊戲原本的限制，讓鏡頭在垂直俯視和望向地平線之間傾斜，還能把視角轉向任何方向。</Text></Replace>
        <Replace Tag="LOC_OPTIONS_GROUP_ZOOM_TILT_ROTATE" Language="zh_Hant_HK"><Text>縮放、俯仰與旋轉</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_OPTION_CLOSE_UP" Language="zh_Hant_HK"><Text>最近能放大到多近</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_OPTION_CLOSE_UP_DESCRIPTION" Language="zh_Hant_HK"><Text>額外的六段縮放能讓你超過遊戲最近的視角多遠，遊戲最近的視角算作1x。7x時可以近距離看清單位。18x時一個單位就佔滿螢幕。36x是遊戲鏡頭允許的極限，你會看到單獨一把劍的劍刃，地面也會變得模糊。變更會立即生效。</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_OPTION_CLOSE_UP_CLOSER" Language="zh_Hant_HK"><Text>更近（7x）</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_OPTION_CLOSE_UP_MUCH_CLOSER" Language="zh_Hant_HK"><Text>近得多（18x）</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_OPTION_CLOSE_UP_ALL_THE_WAY" Language="zh_Hant_HK"><Text>拉到最近（36x）</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_OPTION_KEEP_ANGLE" Language="zh_Hant_HK"><Text>遠景時保持鏡頭傾斜</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_OPTION_KEEP_ANGLE_DESCRIPTION" Language="zh_Hant_HK"><Text>縮放超過遊戲最遠的視角後，鏡頭會轉為垂直俯視。勾選此項可保持你的傾斜角度。鏡頭只會向下傾斜到讓天空不出現在螢幕上為止，在遊戲預設的傾斜角度下則完全不會傾斜。變更會立即生效。</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_OPTION_DEGREES" Language="zh_Hant_HK"><Text>{1_Num}°</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_OPTION_TURN_STEP" Language="zh_Hant_HK"><Text>轉動幅度</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_OPTION_TURN_STEP_DESCRIPTION" Language="zh_Hant_HK"><Text>每按一次轉向鍵，或按一下鏡頭面板中的轉向按鈕，視角轉動的角度。視角會一直朝著那個方向，直到你再次轉動或恢復正常。</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_OPTION_ANGLE_STEP" Language="zh_Hant_HK"><Text>傾斜幅度</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_OPTION_ANGLE_STEP_DESCRIPTION" Language="zh_Hant_HK"><Text>每按一次角度鍵，或按一下鏡頭面板中的角度按鈕，鏡頭在垂直俯視和望向地平線之間傾斜的幅度。</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_OPTION_SHOW_DIALS" Language="zh_Hant_HK"><Text>在螢幕上顯示鏡頭儀表</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_OPTION_SHOW_DIALS_DESCRIPTION" Language="zh_Hant_HK"><Text>在螢幕左上方、勝利和日誌下方，以半透明底板顯示一個小型縮放刻度條、指南針和角度刻度條。沿縮放刻度條拖曳可以縮放，繞著指南針拖曳可以轉動視角，沿角度刻度條拖曳可以傾斜鏡頭。開啟畫面或彈出式視窗時，它們會暫時讓開。</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_OPTION_DIAL_ZOOM" Language="zh_Hant_HK"><Text>螢幕上的縮放刻度條</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_OPTION_DIAL_ZOOM_DESCRIPTION" Language="zh_Hant_HK"><Text>在螢幕上的儀表中顯示縮放刻度條。沿著它拖曳即可縮放。</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_OPTION_DIAL_COMPASS" Language="zh_Hant_HK"><Text>螢幕上的指南針</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_OPTION_DIAL_COMPASS_DESCRIPTION" Language="zh_Hant_HK"><Text>在螢幕上的儀表中顯示指南針。繞著它拖曳即可轉動視角。</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_OPTION_DIAL_ANGLE" Language="zh_Hant_HK"><Text>螢幕上的角度刻度條</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_OPTION_DIAL_ANGLE_DESCRIPTION" Language="zh_Hant_HK"><Text>在螢幕上的儀表中顯示角度刻度條。沿著它拖曳即可傾斜鏡頭。</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_OPTION_KEYS" Language="zh_Hant_HK"><Text>鏡頭按鍵</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_OPTION_KEYS_DESCRIPTION" Language="zh_Hant_HK"><Text>用來傾斜鏡頭、轉動視角、恢復正常和開啟鏡頭面板的按鍵。預設為Shift加方向鍵、0和C。</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_OPTION_KEYS_OPEN" Language="zh_Hant_HK"><Text>變更按鍵</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_KEYS_TITLE" Language="zh_Hant_HK"><Text>鏡頭按鍵</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_KEYS_INTRO" Language="zh_Hant_HK"><Text>按下「變更」，再按下你想要的按鍵，可同時按住Ctrl、Alt（Mac上為Option）和Shift中的任意幾個。按Esc可停止等待。</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_KEYS_CHANGE" Language="zh_Hant_HK"><Text>變更</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_KEYS_CLEAR" Language="zh_Hant_HK"><Text>清除</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_KEYS_RESET" Language="zh_Hant_HK"><Text>重設按鍵</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_KEYS_WAITING" Language="zh_Hant_HK"><Text>請按下按鍵……</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_KEYS_NONE" Language="zh_Hant_HK"><Text>無</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_KEY_TILT_UP" Language="zh_Hant_HK"><Text>朝地平線傾斜</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_KEY_TILT_DOWN" Language="zh_Hant_HK"><Text>朝垂直俯視傾斜</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_KEY_TURN_LEFT" Language="zh_Hant_HK"><Text>向左轉</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_KEY_TURN_RIGHT" Language="zh_Hant_HK"><Text>向右轉</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_KEY_BACK_TO_NORMAL" Language="zh_Hant_HK"><Text>恢復正常</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_KEY_PANEL" Language="zh_Hant_HK"><Text>開啟或關閉鏡頭面板</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_CAMERA_BUTTON" Language="zh_Hant_HK"><Text>鏡頭：縮放、角度和朝向</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_PANEL_ANGLE" Language="zh_Hant_HK"><Text>角度</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_PANEL_KEYS_TIP" Language="zh_Hant_HK"><Text>檢視並變更用來轉動、傾斜、恢復正常和開啟此面板的按鍵。</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_PANEL_HEADING" Language="zh_Hant_HK"><Text>朝向</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_ANGLE_FROM_DOWN" Language="zh_Hant_HK"><Text>{1_Num}°（偏離垂直俯視）</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_TIP_TILT_DOWN" Language="zh_Hant_HK"><Text>再往垂直俯視方向看{1_Num}°。按住可持續傾斜。</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_TIP_TILT_UP" Language="zh_Hant_HK"><Text>再往地平線方向看{1_Num}°。按住可持續傾斜。</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_TIP_TURN_LEFT" Language="zh_Hant_HK"><Text>向左轉{1_Num}°。按住可持續轉動。</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_TIP_TURN_RIGHT" Language="zh_Hant_HK"><Text>向右轉{1_Num}°。按住可持續轉動。</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_TIP_COMPASS" Language="zh_Hant_HK"><Text>繞著指南針拖曳可以轉動視角。</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_TIP_GAUGE" Language="zh_Hant_HK"><Text>沿刻度條拖曳可以傾斜鏡頭。</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_PANEL_ZOOM" Language="zh_Hant_HK"><Text>縮放</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_ZOOM_CLOSER" Language="zh_Hant_HK"><Text>放大{1_Num}倍</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_ZOOM_FAR" Language="zh_Hant_HK"><Text>遠景</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_ZOOM_NORMAL" Language="zh_Hant_HK"><Text>正常縮放</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_TIP_ZOOM_GAUGE" Language="zh_Hant_HK"><Text>沿刻度條拖曳可以縮放。</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_TIP_ZOOM_IN" Language="zh_Hant_HK"><Text>放大一段。按住可持續縮放。</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_TIP_ZOOM_OUT" Language="zh_Hant_HK"><Text>縮小一段。按住可持續縮放。</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_BACK_TO_NORMAL" Language="zh_Hant_HK"><Text>恢復正常</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_BACK_TO_NORMAL_TIP" Language="zh_Hant_HK"><Text>朝向正北，使用遊戲本身的角度，並回到遊戲的縮放範圍內。</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_FACING_NORTH" Language="zh_Hant_HK"><Text>朝北</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_FACING_NORTH_EAST" Language="zh_Hant_HK"><Text>朝東北</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_FACING_EAST" Language="zh_Hant_HK"><Text>朝東</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_FACING_SOUTH_EAST" Language="zh_Hant_HK"><Text>朝東南</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_FACING_SOUTH" Language="zh_Hant_HK"><Text>朝南</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_FACING_SOUTH_WEST" Language="zh_Hant_HK"><Text>朝西南</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_FACING_WEST" Language="zh_Hant_HK"><Text>朝西</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_FACING_NORTH_WEST" Language="zh_Hant_HK"><Text>朝西北</Text></Replace>
