        <Replace Tag="LOC_ZOOM_TILT_ROTATE_KEY_NAME_SPACE" Language="zh_Hant_HK"><Text>空白鍵</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_KEY_NAME_ESC" Language="zh_Hant_HK"><Text>Esc</Text></Replace>
