        <Replace Tag="LOC_ZOOM_TILT_ROTATE_KEY_NAME_SHIFT" Language="zh_Hant_HK"><Text>Shift</Text></Replace>
        <Replace Tag="LOC_ZOOM_TILT_ROTATE_KEY_NAME_CMD" Language="zh_Hant_HK"><Text>Cmd</Text></Replace>
