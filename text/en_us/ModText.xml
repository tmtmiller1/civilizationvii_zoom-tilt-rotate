        <Row Tag="LOC_ZOOM_TILT_ROTATE_KEY_TILT_DOWN">
            <Text>Angle toward straight down</Text>
        </Row>
        <Row Tag="LOC_ZOOM_TILT_ROTATE_KEY_TURN_LEFT">
