        <Row Tag="LOC_ZOOM_TILT_ROTATE_TIP_TILT_UP">
            <Text>Look {1_Num}° more toward the horizon. Hold to keep going.</Text>
        </Row>
        <Row Tag="LOC_ZOOM_TILT_ROTATE_TIP_TURN_LEFT">
            <Text>Turn {1_Num}° left. Hold to keep turning.</Text>
        </Row>
        <Row Tag="LOC_ZOOM_TILT_ROTATE_TIP_TURN_RIGHT">
            <Text>Turn {1_Num}° right. Hold to keep turning.</Text>
        </Row>
        <Row Tag="LOC_ZOOM_TILT_ROTATE_TIP_COMPASS">
            <Text>Drag around the compass to turn the view.</Text>
        </Row>
        <Row Tag="LOC_ZOOM_TILT_ROTATE_TIP_GAUGE">
            <Text>Drag along the gauge to tip the camera.</Text>
        </Row>
        <Row Tag="LOC_ZOOM_TILT_ROTATE_PANEL_ZOOM">
