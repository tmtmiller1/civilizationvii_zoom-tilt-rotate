<?xml version="1.0" encoding="utf-8"?>
<Mod id="tmt-zoom-tilt-rotate" version="1" xmlns="ModInfo">
    <Properties>
        <Name>LOC_MOD_ZOOM_TILT_ROTATE_NAME</Name>
        <Description>LOC_MOD_ZOOM_TILT_ROTATE_DESCRIPTION</Description>
        <Authors>Tower</Authors>
        <Version>1.2.0</Version>
        <AffectsSavedGames>0</AffectsSavedGames>
    </Properties>
    <Dependencies>
        <Mod id="base-standard" title="LOC_MODULE_BASE_STANDARD_NAME" />
    </Dependencies>
    <ActionCriteria>
        <Criteria id="always">
            <AlwaysMet></AlwaysMet>
        </Criteria>
        <!-- Civilopedia History Corrections: the history text on six independent-power pages from Civilopedia
             Expanded: Independents. Each group needs that mod in use, so without it the game's pages are left as
             they are. The text in history-corrections/ is a copy kept in step with the standalone mod. -->
        <Criteria id="history-corrections-antiquity">
            <ModInUse>maple-leaves-civilopedia-expanded</ModInUse>
            <AgeInUse>AGE_ANTIQUITY</AgeInUse>
        </Criteria>
        <Criteria id="history-corrections-exploration">
            <ModInUse>maple-leaves-civilopedia-expanded</ModInUse>
            <AgeInUse>AGE_EXPLORATION</AgeInUse>
        </Criteria>
        <Criteria id="history-corrections-exploration-sengoku">
            <ModInUse>maple-leaves-civilopedia-expanded</ModInUse>
            <AgeInUse>AGE_EXPLORATION</AgeInUse>
            <ModInUse>sengoku</ModInUse>
        </Criteria>
        <Criteria id="history-corrections-exploration-mlcs">
            <ModInUse>maple-leaves-civilopedia-expanded</ModInUse>
            <AgeInUse>AGE_EXPLORATION</AgeInUse>
            <ModInUse>ml-city-states-expanded</ModInUse>
        </Criteria>
    </ActionCriteria>
    <ActionGroups>
        <!-- The Zoom, Tilt, &amp; Rotate rows in Options > Add-ons, in the main menu -->
        <ActionGroup id="zoom-tilt-rotate-shell" scope="shell" criteria="always">
            <Actions>
                <UpdateText>
                    <Item>text/en_us/ModText.xml</Item>
                    <Item locale="de_DE">text/de_de/ModText.xml</Item>
                    <Item locale="es_ES">text/es_es/ModText.xml</Item>
                    <Item locale="fr_FR">text/fr_fr/ModText.xml</Item>
                    <Item locale="it_IT">text/it_it/ModText.xml</Item>
                    <Item locale="ja_JP">text/ja_jp/ModText.xml</Item>
                    <Item locale="ko_KR">text/ko_kr/ModText.xml</Item>
                    <Item locale="pl_PL">text/pl_pl/ModText.xml</Item>
                    <Item locale="pt_BR">text/pt_br/ModText.xml</Item>
                    <Item locale="ru_RU">text/ru_ru/ModText.xml</Item>
                    <Item locale="zh_Hans_CN">text/zh_cn/ModText.xml</Item>
                    <Item locale="zh_Hant_HK">text/zh_hk/ModText.xml</Item>
                </UpdateText>
                <UIScripts>
                    <!-- Tower Settings Keeper: listed first, imports nothing, so it runs before anything reads storage. -->
                    <Item>ui/settings-keeper.js</Item>
                    <Item>ui/zoom-tilt-rotate-options.js</Item>
                </UIScripts>
                <ImportFiles>
                    <Item>ui/zoom-tilt-rotate-options.js</Item>
                    <Item>ui/zoom-tilt-rotate-settings.js</Item>
                    <Item>ui/zoom-tilt-rotate-keys-editor.js</Item>
                </ImportFiles>
            </Actions>
        </ActionGroup>
        <ActionGroup id="zoom-tilt-rotate-game" scope="game" criteria="always">
            <Actions>
                <UpdateText>
                    <Item>text/en_us/ModText.xml</Item>
                    <Item locale="de_DE">text/de_de/ModText.xml</Item>
                    <Item locale="es_ES">text/es_es/ModText.xml</Item>
                    <Item locale="fr_FR">text/fr_fr/ModText.xml</Item>
                    <Item locale="it_IT">text/it_it/ModText.xml</Item>
                    <Item locale="ja_JP">text/ja_jp/ModText.xml</Item>
                    <Item locale="ko_KR">text/ko_kr/ModText.xml</Item>
                    <Item locale="pl_PL">text/pl_pl/ModText.xml</Item>
                    <Item locale="pt_BR">text/pt_br/ModText.xml</Item>
                    <Item locale="ru_RU">text/ru_ru/ModText.xml</Item>
                    <Item locale="zh_Hans_CN">text/zh_cn/ModText.xml</Item>
                    <Item locale="zh_Hant_HK">text/zh_hk/ModText.xml</Item>
                </UpdateText>
                <ImportFiles>
                    <Item>ui/zoom-tilt-rotate-options.js</Item>
                    <Item>ui/zoom-tilt-rotate-settings.js</Item>
                    <Item>ui/zoom-tilt-rotate-keys-editor.js</Item>
                    <Item>ui/zoom-tilt-rotate-view.js</Item>
                    <Item>ui/zoom-tilt-rotate-icons.js</Item>
                    <Item>icons/camera.png</Item>
                    <Item>icons/turn-left.png</Item>
                    <Item>icons/turn-right.png</Item>
                    <Item>icons/compass-ring.png</Item>
                    <Item>icons/compass-needle.png</Item>
                    <Item>icons/angle-gauge.png</Item>
                    <Item>icons/angle-needle.png</Item>
                    <Item>icons/zoom-gauge.png</Item>
                    <Item>icons/zoom-needle.png</Item>
                </ImportFiles>
                <UIScripts>
                    <Item>ui/settings-keeper.js</Item>
                    <Item>ui/zoom-tilt-rotate.js</Item>
                    <Item>ui/zoom-tilt-rotate-options.js</Item>
                    <!-- The camera keys and the camera panel (minimap button) -->
                    <Item>ui/zoom-tilt-rotate-keys.js</Item>
                    <Item>ui/zoom-tilt-rotate-panel.js</Item>
                </UIScripts>
            </Actions>
        </ActionGroup>
        <!-- Civilopedia History Corrections, loaded at 1000 to come after Civilopedia Expanded's groups (10, 100
             and 210). Text only. -->
        <ActionGroup id="history-corrections-antiquity-text" scope="game" criteria="history-corrections-antiquity">
            <Properties>
                <LoadOrder>1000</LoadOrder>
            </Properties>
            <Actions>
                <UpdateText>
                    <Item>history-corrections/antiquity-text.xml</Item>
                </UpdateText>
            </Actions>
        </ActionGroup>
        <ActionGroup id="history-corrections-exploration-text" scope="game" criteria="history-corrections-exploration">
            <Properties>
                <LoadOrder>1000</LoadOrder>
            </Properties>
            <Actions>
                <UpdateText>
                    <Item>history-corrections/exploration-text.xml</Item>
                </UpdateText>
            </Actions>
        </ActionGroup>
        <ActionGroup id="history-corrections-exploration-sengoku-text" scope="game" criteria="history-corrections-exploration-sengoku">
            <Properties>
                <LoadOrder>1000</LoadOrder>
            </Properties>
            <Actions>
                <UpdateText>
                    <Item>history-corrections/exploration-sengoku-text.xml</Item>
                </UpdateText>
            </Actions>
        </ActionGroup>
        <ActionGroup id="history-corrections-exploration-mlcs-text" scope="game" criteria="history-corrections-exploration-mlcs">
            <Properties>
                <LoadOrder>1000</LoadOrder>
            </Properties>
            <Actions>
                <UpdateText>
                    <Item>history-corrections/exploration-mlcs-text.xml</Item>
                </UpdateText>
            </Actions>
        </ActionGroup>
    </ActionGroups>
    <LocalizedText>
        <File>text/en_us/ModText.xml</File>
    </LocalizedText>
</Mod>
